@model List<QuanLyAmThucNhaTrang.DAL.DANHGIA>
@{
    ViewBag.Title = "Quản lý Đánh giá & Phản hồi";
}

<div class="container mt-5 mb-5" style="min-height: 60vh;">
    @if (Model != null && Model.Count > 0)
    {
        foreach (var item in Model)
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-secondary bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center fw-bold text-secondary" style="width: 45px; height: 45px;">
                                @item.TAIKHOAN.HoTen.Substring(0, 1).ToUpper()
                            </div>
                            <div>
                                <h6 class="fw-bold m-0">@item.TAIKHOAN.HoTen</h6>
                                <small class="text-muted">Đánh giá quán: <span class="text-primary fw-semibold">@item.DIADIEM.TenDD</span></small>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="text-warning mb-1">
                                @for (int i = 0; i < item.SoSao; i++)
                                {<i class="bi bi-star-fill"></i>}
                                @for (int i = item.SoSao; i < 5; i++)
                                {<i class="bi bi-star text-muted opacity-25"></i>}
                            </div>
                            <small class="text-muted">@item.NgayDanhGia.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    </div>
                    <p class="text-body mb-3 fw-medium">@item.NoiDung</p>

                    @{
                        // Lấy ra phản hồi đầu tiên của chủ quán (vì mỗi đánh giá chỉ có 1 phản hồi)
                        var phanHoiCuaQuan = item.PHANHOI.FirstOrDefault();
                    }

                    @if (phanHoiCuaQuan != null)
                    {
                        <div class="ms-5 ps-4 border-start border-3 border-primary bg-primary bg-opacity-10 p-3 rounded-3 position-relative">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold text-primary m-0"><i class="bi bi-shop me-1"></i> Cơ sở phản hồi</h6>
                                <small class="text-muted">@phanHoiCuaQuan.NgayPhanHoi.ToString("dd/MM/yyyy")</small>
                            </div>
                            <p class="text-body mb-3 small">@phanHoiCuaQuan.NoiDung</p>

                            <div class="d-flex gap-2 justify-content-end">
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1" style="font-size: 0.75rem;"
                                        onclick="moModalSuaPH(@phanHoiCuaQuan.MaPH, '@phanHoiCuaQuan.NoiDung')"
                                        data-bs-toggle="modal" data-bs-target="#modalSuaPH">
                                    <i class="bi bi-pencil me-1"></i>Sửa phản hồi
                                </button>

                                <form action="@Url.Action("XoaPhanHoi", "ChuCSKD")" method="POST" class="m-0" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phản hồi này?');">
                                    <input type="hidden" name="maPH" value="@phanHoiCuaQuan.MaPH" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1" style="font-size: 0.75rem;">
                                        <i class="bi bi-trash3 me-1"></i>Xóa
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="ms-5 mt-2 d-flex align-items-center gap-3">
                            <button type="button" class="btn btn-sm rounded-pill fw-bold text-primary border shadow-sm px-4 py-2"
                                    onclick="moModalGuiPH(@item.MaDG, '@item.TAIKHOAN.HoTen', '@item.DIADIEM.TenDD')"
                                    data-bs-toggle="modal" data-bs-target="#modalGuiPH">
                                <i class="bi bi-reply-fill me-1"></i>Viết phản hồi
                            </button>

                            <span class="badge text-secondary border rounded-pill px-3 py-2 shadow-sm">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @item.DIADIEM.TenDD
                            </span>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5 border rounded-4 bg-opacity-10">
            <i class="bi bi-chat-square-heart text-muted display-3"></i>
            <h5 class="text-muted mt-3 fw-bold">Chưa có đánh giá nào</h5>
        </div>
    }
</div>

<div class="modal fade" id="modalGuiPH" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form action="@Url.Action("GuiPhanHoi", "ChuCSKD")" method="POST" class="modal-content rounded-4 border-0 shadow">
            <input type="hidden" name="MaDG" id="input_MaDG_Gui" />

            <div class="modal-header bg-primary bg-opacity-10 border-bottom-0 pb-3">
                <div>
                    <h6 class="fw-bold m-0 text-primary mb-1"><i class="bi bi-chat-dots-fill me-2"></i>Gửi phản hồi cho khách hàng</h6>
                    <small class="text-muted">
                        Khách hàng: <strong id="hienThi_TenKhach" class=""></strong> <br />
                        Cơ sở: <strong id="hienThi_TenQuan" class="text-danger"></strong>
                    </small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" style="align-self: flex-start;"></button>
            </div>

            <div class="modal-body p-4 pt-2">
                <textarea name="NoiDung" class="form-control border-0 rounded-3 p-3" rows="4" placeholder="Nhập lời cảm ơn hoặc giải thích của bạn để khách hàng hiểu rõ hơn..." required></textarea>
            </div>

            <div class="modal-footer border-top-0 pt-0">
                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold w-100 shadow-sm">Gửi phản hồi công khai</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modalSuaPH" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form action="@Url.Action("SuaPhanHoi", "ChuCSKD")" method="POST" class="modal-content rounded-4 border-0 shadow">
            <input type="hidden" name="maPH" id="input_MaPH_Sua" />
            <div class="modal-header">
                <h6 class="fw-bold m-0 text-primary"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa phản hồi</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <textarea name="noiDungMoi" id="input_NoiDung_Sua" class="form-control rounded-3 border-0 p-3" rows="4" required></textarea>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

<script>
    function moModalGuiPH(maDG, tenKhach, tenQuan) {
        document.getElementById('input_MaDG_Gui').value = maDG;
        document.getElementById('hienThi_TenKhach').innerText = tenKhach;
        document.getElementById('hienThi_TenQuan').innerText = tenQuan;
    }

    function moModalSuaPH(maPH, noiDungCu) {
        document.getElementById('input_MaPH_Sua').value = maPH;
        document.getElementById('input_NoiDung_Sua').value = noiDungCu;
    }
</script>