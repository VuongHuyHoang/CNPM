@model List<QuanLyAmThucNhaTrang.DAL.THAMSO>
@{ ViewBag.Title = "Cấu hình Tham số hệ thống"; }

<div class="container mt-4 mb-5" style="max-width: 900px;">
    <div class="border-bottom pb-3 mb-4">
        <h3 class="fw-bold m-0"><i class="bi bi-gear-wide-connected text-secondary me-2"></i>Tham số hệ thống</h3>
        <p class="text-muted small m-0 mt-1">Lưu ý: Việc thay đổi các tham số này sẽ tác động trực tiếp đến toàn bộ logic hoạt động của website.</p>
    </div>

    @if (TempData["Success"] != null)
    {<div class="alert alert-success small">@TempData["Success"]</div>}
    @if (TempData["Error"] != null)
    {<div class="alert alert-danger small">@TempData["Error"]</div>}

    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-12">
                <form action="@Url.Action("CapNhatThamSo", "Admin")" method="POST" class="card border border-translucent shadow-sm rounded-4">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center gap-4">
                        <div class="flex-grow-1">
                            <h6 class="fw-bold text-dark mb-1">@item.TenThamSo</h6>
                            <p class="text-muted small m-0">@item.MoTa</p>
                        </div>
                        <div class="d-flex align-items-center gap-2" style="width: 250px;">
                            <input type="hidden" name="MaThamSo" value="@item.MaThamSo" />
                            <input type="text" name="GiaTri" class="form-control text-center fw-bold" value="@item.GiaTri" required />
                            <button type="submit" class="btn btn-secondary rounded-3" title="Lưu tham số"><i class="bi bi-save"></i></button>
                        </div>
                    </div>
                </form>
            </div>
        }
    </div>
</div>