@model IEnumerable<QuanLyAmThucNhaTrang.DAL.DANHMUC>

@{
    ViewBag.Title = "Trang Chủ";
}

<div style="margin-top: 50px;">
    <h2>Test Kết Nối 3 Lớp</h2>
    <hr />
    <h3>Danh sách Danh mục Ẩm thực tại Nha Trang:</h3>

    <ul>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <li>
                    <strong>@item.TenDM</strong> - Trạng thái: @item.TrangThai
                    <br />
                    <em>@item.MoTa</em>
                </li>
            }
        }
        else
        {
            <li>Không có dữ liệu hoặc kết nối thất bại!</li>
        }
    </ul>
</div>